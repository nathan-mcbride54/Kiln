{
  "name": "kiln-product-preview",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run roadmap:check && npm run fixtures:check && npm run desktop:contract-check && npm run build && node --test tests/rendered-html.test.mjs tests/desktop-events.test.ts tests/platform-fixtures.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern desktop/dist --ignore-pattern .next --ignore-pattern .kiln-validation --ignore-pattern .kiln-cargo-target --ignore-pattern target --ignore-pattern desktop/src-tauri/target",
    "roadmap:render": "node scripts/render-roadmap.mjs",
    "roadmap:check": "node scripts/render-roadmap.mjs --check",
    "fixtures:render": "node scripts/render-recorded-session.mjs",
    "fixtures:check": "node scripts/render-recorded-session.mjs --check",
    "desktop:contract-check": "tsc --project desktop/tsconfig.contract.json"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
